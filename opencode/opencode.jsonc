// vim: set tabstop=2 shiftwidth=2 expandtab nospell:
{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest", // markdown tables formatter
    "@mohak34/opencode-notifier@latest",        // notification when a command is finished
    ["@plannotator/opencode@latest", { "workflow": "manual" }] // plannotator plugin for commenting plans
  ],
  "provider": {
    "llmproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM Proxy",
      "options": {
        "baseURL": "https://llmproxy.ai.orange",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "vertex_ai/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5 - rapide économique",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 1, "output": 5 }
        },
        "vertex_ai/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 - équilibré",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 3, "output": 15 },
          "variants": {
            "default": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking_default": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            },
            "max_thinking": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            }
          }
        },
        "vertex_ai/claude-sonnet-5": {
          "name": "Claude Sonnet 5 - équilibré",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 3, "output": 15 },
          "variants": {
            "default": {
              "thinking": {
                "type": "disabled"
              }
            },
            "thinking_default": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 16000
              }
            },
            "max_thinking": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 32000
              }
            }
          }
        },
        "vertex_ai/claude-opus-4-5": {
          "name": "Claude Opus 4.5 - puissant cher",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 5, "output": 25 }
        },
        "vertex_ai/claude-opus-4-6": {
          "name": "Claude Opus 4.6 - puissant cher",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 5, "output": 25 }
        },
        "vertex_ai/claude-opus-4-7": {
          "name": "Claude Opus 4.7 - puissant cher",
          "family": "Claude",
          "limit": { "output": 64000, "context": 200000 },
          "cost": { "input": 5, "output": 25 }
        },
        "vertex_ai/gemini-2.0-flash": {
          "name": "Gemini 2 Flash",
          "family": "Gemini",
          "limit": { "output": 8192, "context": 1048576 }
        },
        "openai/gpt-5.1-codex": {
          "name": "GPT 5.1 Codex - Pour la génération de code",
          "family": "GPT",
          "cost": { "input": 1.25, "output": 10 }
        },
        "openai/gpt-5.2-codex": {
          "name": "GPT 5.2 Codex - Pour la génération de code",
          "family": "GPT",
          "cost": { "input": 1.75, "output": 14 }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        // en local
        // "baseURL": "http://localhost:9988/v1/",
        // sur le pc de gamer de albin
        "baseURL": "http://192.168.1.25:1234/v1/",
        "apiKey": "lm-studio"
      },
      "models": {
        "qwen/qwen3-coder-next": {
          "name": "Qwen 3 Coder next",
          "family": "Qwen",
          "reasoning": true,
          "tool_call": true
        },
       "qwen/qwen2.5-coder-14b": {
          "name": "Qwen 2.5 Coder",
          "family": "Qwen",
          "limit": { "output": 8192, "context": 32768 },
          "reasoning": true,
          "tool_call": true
        },
        "lumynax-coder-deepseek-v2-lite-16b": {
          "name": "Lumynax Deepseek v2 Lite 16B",
          "family": "Lumynax",
          "reasoning": true,
          "tool_call": true
        }
      }
    },
    // 2026-05-06 : testé APFEL en localhost
    // PRB BLOQUANT : la fenêtre de contexte est très limitée (4096 tokens) ce qui est trop peu pour les instructions complexes d'opencode
    // "apfel": {
    //   "npm": "@ai-sdk/openai-compatible",
    //   "name": "APFEL (local)",
    //   "options": {
    //     "baseURL": " http://localhost:11434/v1/",
    //   },
    //   "models": {
    //     "apple-foundationmodel": {
    //       "name": "Apple Foundation Model via tool APFEL",
    //     }
    //   }
    // },

    // https://doc.diod.tech.orange/openrama/how_to_use/anythingllm.en/
    // see model list : https://doc.diod.tech.orange/openrama/how_to_access/models_list.en/
    // or (BETTER)
    // curl -X GET "https://llm.openrama.tech.orange/v1/models" \
    //     -H "Authorization: Bearer YOUR_API_KEY"
    "openrama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Openrama",
      "options": {
        "baseURL": "https://llm.openrama.tech.orange",
        "apiKey": "{env:OPENRAMA_API_KEY}"
      },
      "models": {
        "devstral-small-2-24b-instruct": {
          "name": "devstral-small-2-24b-instruct",
          "tool_call": true
        },
        "gemma-3-12b-instruct": {
          "name": "gemma-3-12b-instruct",
          "tool_call": true
        },
        "qwen2.5-coder-7b-instruct": {
          "name": "qwen2.5-coder-7b-instruct",
        },
        // 2026-06-08 : test sur obsperso basic OK
        "minimax-m2.5": {
          "name": "minimax-m2.5",
          "reasoning": true,
          "tool_call": true
        },
        // 2026-06-08 : test sur obsperso basic KO
        "qwen3.5-122b": {
          "name": "qwen3.5-122b",
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "disabled_providers": ["anthropic", "openai"],
  // Remplacement des formatteurs par défaut ou ajout de nouveaux formatteurs
  "formatter" : {
    // "stylua": {
    //   "command": ["stylua", "--indent-type", "spaces", "--indent-width", "2", "$FILE"],
    //   "extensions": [".lua"]
    // }
  },
  // autorisation d'exécution des commandes
 "permission": {
    // Restrictions sur les commandes bash
    "bash": {
      // Demander pour toutes les commandes par défaut (last-match-wins : cette règle est écrasée par les suivantes)
      "*": "ask",
      // Commandes git INTERDITES : modifient l'index ou l'historique du dépôt
      // Conformément à AGENTS.md, section "GIT usage limitations"
      // Autorisées implicitement : git status, git diff, git log, git show, git branch
      "git status *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git stash *": "deny",
      "git rebase *": "deny",
      "git revert *": "deny",
      "git reset *": "deny",
      "colima status": "allow",
      "colima version": "allow",
      "docker context ls": "allow",
      // get current date
      "date *": "allow",
      "npm list*" : "allow",
      "ls *" : "allow",
      "wc *" : "allow",
      "diff *" : "allow",
      "echo *": "allow",
      "grep *" : "allow",
      "head *" : "allow",
      "tail *" : "allow",
      "obsidian tasks*" : "allow",
      "gog --account machboboss@gmail.com calendar*": "allow",
      "omnisearch query *": "allow"

    }
  },
  "lsp": {
    "markdown": {
      "disabled": false,
      "command": ["marksman", "server"],
      "extensions": [".md", ".markdown"]
    },
    "go": {
      "disabled": false,
      "command": ["gopls"],
      "extensions": [".go"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY_FOR_MCP}"
      },
      "enabled": true
    }
  },
  "command": {
    "daily_tip_opencode": {
      "template": "lis les fichiers @dotfiles/opencode/ et la doc context7 et propose moi une fiche conseil du jour sur une fonctionnalité d'opencode nouvelle ou importante et que je ne semble pas utiliser. Ecris en Français.",
      "description": "Conseil du jour sur opencode",
      "agent": "plan",
      "model": "llmproxy/vertex_ai/claude-opus-4-5"
    },
    "daily_tip_kodi": {
      "template": " propose moi une fiche conseil du jour sur une fonctionnalité de kodi nouvelle ou importante et que je ne semble pas utiliser. Ecris en Français.",
      "description": "Conseil du jour sur opencode",
      "agent": "plan",
      "model": "llmproxy/vertex_ai/claude-opus-4-5"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "skill": {
          "plannotator-*": "deny",
          "edit": "deny"
        },
        "bash": {
          "git remote get-url origin": "allow",
          "glab issue view*": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "bash": {
          "which*": "allow",
          "find*": "allow",
          "sort*": "allow",
          "git remote get-url origin": "allow",
          "glab issue view*": "allow",
          "lychee *": "allow",
          "jq *": "allow",
          "npm run lychee*": "allow"
        }
      }
    }
  }
}
